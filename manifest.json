{
  "manifest_version": 3,
  "name": "Scholar Rank",
  "version": "1.4.0",
  "description": "Journal JCR quartiles, CAS broad-category tiers, impact factors and TOP status; conference acronyms, CCF and CORE rankings on Google Scholar.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Scholar Rank",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.com.tw/*",
        "https://scholar.google.com.sg/*",
        "https://scholar.google.com.au/*",
        "https://scholar.google.com.br/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.co.kr/*",
        "https://scholar.google.co.in/*",
        "https://scholar.google.ca/*",
        "https://scholar.google.de/*",
        "https://scholar.google.fr/*",
        "https://scholar.google.it/*",
        "https://scholar.google.es/*",
        "https://scholar.google.nl/*",
        "https://scholar.google.ru/*",
        "https://scholar.google.ch/*",
        "https://scholar.google.se/*",
        "https://scholar.google.pl/*",
        "https://scholar.google.cn/*",
        "https://xueshu.lanfanshu.cn/*",
        "https://scholar.lanfanshu.cn/*",
        "https://sc.panda985.com/*"
      ],
      "js": [
        "src/lib/settings.js",
        "src/lib/normalize.js",
        "src/lib/ranking.js",
        "src/lib/stats.js",
        "src/lib/backend.js",
        "src/content/scholar.js"
      ],
      "css": [
        "src/content/badges.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/data/*.json"
      ],
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.com.tw/*",
        "https://scholar.google.com.sg/*",
        "https://scholar.google.com.au/*",
        "https://scholar.google.com.br/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.co.kr/*",
        "https://scholar.google.co.in/*",
        "https://scholar.google.ca/*",
        "https://scholar.google.de/*",
        "https://scholar.google.fr/*",
        "https://scholar.google.it/*",
        "https://scholar.google.es/*",
        "https://scholar.google.nl/*",
        "https://scholar.google.ru/*",
        "https://scholar.google.ch/*",
        "https://scholar.google.se/*",
        "https://scholar.google.pl/*",
        "https://scholar.google.cn/*",
        "https://xueshu.lanfanshu.cn/*",
        "https://scholar.lanfanshu.cn/*",
        "https://sc.panda985.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://127.0.0.1:8124/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://api.deepseek.com/*"
  ],
  "minimum_chrome_version": "114"
}
